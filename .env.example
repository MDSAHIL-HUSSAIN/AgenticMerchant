FACEBOOK_CLOUDINARY_API_KEY=
FACEBOOK_CLOUDINARY_API_SECRET=
FACEBOOK_PUBLISH_URL=https://their-vercel-project.vercel.app/api/publish
FACEBOOK_PUBLISH_SECRET=

# Dedicated image-post adapter for the teammate's Instagram service. Agentic
# sends the approved instagram_portrait export as multipart field `file`.
